{
  "name": "ics-analyzer-desktop",
  "version": "1.0.4",
  "description": "ICS Analyzer - Aplicativo desktop (Windows) empacotado com Electron",
  "main": "main.js",
  "author": "ICS Analyzer Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --config.directories.output=dist_release --dir",
    "dist": "electron-builder --config.directories.output=dist_release",
    "dist:nsis": "electron-builder --config.directories.output=dist_release --win nsis",
    "pack:temp": "powershell -NoProfile -Command \"$out=Join-Path $env:TEMP 'ics-analyzer-dist'; .\\node_modules\\.bin\\electron-builder.cmd --config.directories.output=$out --dir\"",
    "dist:temp": "powershell -NoProfile -Command \"$out=Join-Path $env:TEMP 'ics-analyzer-dist'; .\\node_modules\\.bin\\electron-builder.cmd --config.directories.output=$out\"",
    "dist:nsis:temp": "powershell -NoProfile -Command \"$out=Join-Path $env:TEMP 'ics-analyzer-dist'; Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $out; .\\node_modules\\.bin\\electron-builder.cmd --config.directories.output=$out --win nsis\""
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "br.ufs.icsanalyzer",
    "productName": "ICS Analyzer",
    "directories": {
      "output": "dist_release"
    },
    "files": [
      "main.js",
      "package.json",
      "build/**"
    ],
    "extraResources": [
      {
        "from": "../docs",
        "to": "docs"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
